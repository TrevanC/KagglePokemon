# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# macOS
.DS_Store

# Claude Code machine-local settings
.claude/settings.local.json

# Competition card-ID reference PDFs — 174 MB and 131 MB, well over GitHub's
# 100 MB per-file hard limit. Re-download them with the Kaggle bundle if
# needed; EN_Card_Data.csv carries the same data in a usable form.
pokemon-tcg-ai-battle/*.pdf

# Experiment tracking
wandb/

# Model artifacts and generated data. The contents are regenerated by the
# pipeline scripts; only the directory structure is tracked.
#
# The `!.../**/` lines re-include the directories themselves — git does not
# descend into an excluded directory, so without them the negations below
# could never match anything inside.
data/**
!data/**/
models/**
!models/**/
submission/build/**
!submission/build/**/
submission/*.tar.gz
*.pt

# ...so that these survive: the static card database (the tracked pipeline
# input) and the .gitkeep markers that preserve the empty directories.
!data/raw/EN_Card_Data.csv
!**/.gitkeep
